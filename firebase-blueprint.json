{
  "entities": {
    "Game": {
      "title": "Game",
      "description": "Video game product for Steam, Epic Games, PS4, and PS5",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "platform": { "type": "string", "enum": ["steam", "epic", "ps4", "ps5"] },
        "type": { "type": "string", "enum": ["cd_key", "offline_account", "full_account"] },
        "genre": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "description": { "type": "string", "maxLength": 3000 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "bannerImage": { "type": "string", "maxLength": 500 },
        "edition": { "type": "string", "maxLength": 60 },
        "deliveryType": { "type": "string", "maxLength": 60 },
        "activationGuide": { "type": "string", "maxLength": 2000 },
        "systemRequirements": { "type": "string", "maxLength": 1500 },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isDealOfTheDay": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "platform", "price", "originalPrice", "inStock"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["superadmin", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer game purchase order",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "delivered", "processing", "cancelled"] },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentId": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 25 },
        "customerName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "userEmail", "totalAmount", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount voucher code",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 30 },
        "discountPercent": { "type": "number" },
        "minSpend": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["code", "discountPercent", "isActive"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified customer feedback for game products",
      "type": "object",
      "properties": {
        "gameId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["gameId", "userId", "userName", "rating", "comment"]
    },
    "User": {
      "title": "User",
      "description": "Public and private user account profile",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 25 },
        "role": { "type": "string", "maxLength": 20 },
        "wishlist": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Newsletter": {
      "title": "Newsletter",
      "description": "Captured subscriber email for promotional updates",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "subscribedAt": { "type": "string" }
      },
      "required": ["email"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Store configuration for UPI scanner and WhatsApp support number",
      "type": "object",
      "properties": {
        "upiId": { "type": "string", "maxLength": 100 },
        "upiPayeeName": { "type": "string", "maxLength": 100 },
        "upiQrImage": { "type": "string", "maxLength": 500 },
        "whatsappNumber": { "type": "string", "maxLength": 25 },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/Game" },
      "description": "Catalog of digital games across Steam, Epic, PS4, and PS5"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Admin white-list records"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Purchased orders and digital delivery status"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional coupons for discounts"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "User reviews and ratings for games"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile with personal library and wishlist"
    },
    "/newsletter/{subscriberId}": {
      "schema": { "$ref": "#/entities/Newsletter" },
      "description": "Promotional email subscriber list"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Storewide settings including live UPI ID, QR scanner and WhatsApp number"
    }
  }
}
