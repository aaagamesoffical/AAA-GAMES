rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Games collection: Store catalog (full admin edit/delete control)
    match /games/{gameId} {
      allow read, write: if true;
    }

    // Admins collection: Authorized admin identities
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Orders collection: Customer orders & receipts, admin management
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Coupons collection: Instant discount codes, admin create/remove
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Reviews collection: Verified customer photo proofs & reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Users collection: User profile data
    match /users/{userId} {
      allow read, write: if true;
    }

    // Newsletter collection: Email subscribers
    match /newsletter/{subscriberId} {
      allow read, write: if true;
    }

    // Settings collection: UPI scanner, WhatsApp number, announcements
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
